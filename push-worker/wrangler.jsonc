{
  "name": "argens-alerte-push",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "argens-alerte-db",
      "database_id": "2333f322-e49e-412f-bcf6-d12b9b49256f"
    }
  ],
  "vars": {
    "AUTH_EMAIL_FROM": "Rivière Alerte <login@riviere-alerte.fr>",
    "VAPID_PUBLIC_KEY": "BNmAS3Gm-VN8T9-_TsA4viBni7q-TwNk0dMEcWR6QYdb0T-fHEQ0Nz8s2sIlCrIBPW_A9LdqI8paKvVqCStUOrA",
    "VAPID_SUBJECT": "mailto:login@riviere-alerte.fr"
  },
  "ai": {
    "binding": "AI"
  }
}
